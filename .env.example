# ============================================
# GOOGLE ADSENSE CONFIGURATION
# ============================================
# IMPORTANT: Set VITE_ADS_ENABLED=true ONLY after:
# 1. Your site is approved by Google AdSense
# 2. You have created ad units in your AdSense dashboard
# 3. All required slot IDs below are configured
#
# When ads are disabled, NO advertisements will be shown on the website.
# No fallback or placeholder ads will be displayed.
# ============================================

VITE_ADS_ENABLED=false

# Your AdSense publisher/client ID from Google AdSense
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Find this in: AdSense Dashboard > Account > Settings > Account Information
VITE_ADSENSE_CLIENT=

# ============================================
# AD UNIT SLOT IDs
# ============================================
# Create these ad units in your AdSense dashboard:
# AdSense Dashboard > Ads > By ad unit > Display ads
# Use "Responsive" ad type for all units
# Copy the data-ad-slot ID (numbers only) for each unit
# ============================================

# Main site top banner ad (used on home page)
VITE_ADSENSE_MAIN_TOP_SLOT=

# Game catalog page - top banner
VITE_ADSENSE_GAME_TOP_SLOT=

# Game catalog page - bottom banner
VITE_ADSENSE_GAME_BOTTOM_SLOT=

# Game detail page - top ad (large on mobile, banner on desktop)
VITE_ADSENSE_GAME_DETAIL_TOP_SLOT=

# Game detail page - middle ad (below game player)
VITE_ADSENSE_GAME_DETAIL_MID_SLOT=

# Game detail page - bottom ad (above related games)
VITE_ADSENSE_GAME_DETAIL_BOTTOM_SLOT=

# ============================================
# ADDITIONAL SETTINGS
# ============================================
# Auto ads and interstitial/vignette ads can be enabled
# directly in the AdSense dashboard under Ads > By site
# The AdSense script is automatically loaded when ads are enabled
# ============================================

# Google Analytics Measurement ID (optional)
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
