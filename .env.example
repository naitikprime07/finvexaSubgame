# ============================================
# GOOGLE ADSENSE CONFIGURATION
# ============================================
# IMPORTANT: Set VITE_ADS_ENABLED=true ONLY after:
# 1. Your site is approved by Google AdSense
# 2. You have created ad units in your AdSense dashboard
# 3. All required ad unit IDs below are configured
# 4. Updated public/ads.txt with your Publisher ID
#
# When ads are disabled, NO advertisements will be shown on the website.
# No fallback or placeholder ads will be displayed.
# ============================================
#
# ⚠️ ABOUT VITE_ PREFIX AND SECURITY:
# All variables below use the VITE_ prefix because this is a FRONTEND-ONLY
# application. The VITE_ prefix makes these values available to browser code.
#
# ✅ THESE ARE INTENTIONALLY PUBLIC - NOT SECRETS:
# - AdSense Publisher IDs are MEANT to be public (visible in HTML source)
# - Ad Unit Slot IDs are MEANT to be public (visible in HTML source)
# - Google Analytics IDs are MEANT to be public (visible in HTML source)
# - These appear in EVERY website's source code that uses AdSense/Analytics
# - The VITE_ prefix is CORRECT and REQUIRED for this use case
#
# ❌ DO NOT PUT ACTUAL SECRETS HERE:
# - API keys for server-side services
# - Database credentials
# - Authentication tokens
# - Private encryption keys
#
# Since this is a static frontend app with no backend, all config must be
# client-side accessible. Only add variables that are safe to expose publicly.
# ============================================

# Master toggle to enable/disable all ads across the site
# Type: boolean (true/false)
# Public: Yes (controls frontend behavior)
VITE_ADS_ENABLED=false

# Your AdSense Publisher ID (also called Client ID)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Find this in: AdSense Dashboard > Account > Settings > Account Information
# This MUST match the Publisher ID in public/ads.txt
# Public: Yes (required by browser to load AdSense script)
# Security: Not a secret - this ID is visible in every AdSense website's HTML
VITE_ADSENSE_PUBLISHER_ID=

# ============================================
# DISPLAY AD UNITS (Banner Format)
# ============================================
# Create these in: AdSense Dashboard > Ads > By ad unit > Display ads
# Ad Type: Responsive Display Ads
# Copy the "data-ad-slot" ID (numbers only, e.g., 1234567890)
#
# Public: Yes (required by browser to display ads)
# Security: Not secrets - these IDs are visible in page HTML
# ============================================

# BANNER AD: Main homepage top section
# Placement: Top of homepage, above main content
# Size: 970x90 desktop, 320x100 mobile
# Format: Banner
VITE_AD_BANNER_HOME_TOP=

# BANNER AD: Game catalog page - top
# Placement: Above game grid on catalog/browse page
# Size: 970x90 desktop, 320x100 mobile
# Format: Banner
VITE_AD_BANNER_CATALOG_TOP=

# BANNER AD: Game catalog page - bottom
# Placement: Below game grid on catalog/browse page
# Size: 970x90 desktop, 320x100 mobile
# Format: Banner
VITE_AD_BANNER_CATALOG_BOTTOM=

# BANNER AD: Game detail page - top section
# Placement: Above game player on individual game page
# Size: 970x90 desktop, 336x280 mobile (large mobile unit)
# Format: Banner/Rectangle (responsive)
VITE_AD_BANNER_GAME_TOP=

# BANNER AD: Game detail page - middle section
# Placement: Between game player and game description
# Size: 970x90 desktop, 320x100 mobile
# Format: Banner
VITE_AD_BANNER_GAME_MID=

# BANNER AD: Game detail page - bottom section
# Placement: Below game description, above related games
# Size: 970x90 desktop, 320x100 mobile
# Format: Banner
VITE_AD_BANNER_GAME_BOTTOM=

# ============================================
# OPTIONAL AD FORMATS
# ============================================
# These ad formats can be enabled in your AdSense dashboard
# without additional environment variables:
#
# - ANCHOR ADS: Sticky mobile bottom banner
#   Enable in: AdSense Dashboard > Ads > By site > Auto ads
#
# - INTERSTITIAL ADS: Full-screen ads between page loads
#   Enable in: AdSense Dashboard > Ads > By site > Auto ads
#
# - IN-FEED NATIVE ADS: Ads within content feeds
#   Requires custom implementation (not currently used)
#
# - IN-ARTICLE NATIVE ADS: Ads within article content
#   Requires custom implementation (not currently used)
#
# - REWARDED ADS: User watches ad for reward
#   Requires custom implementation (not currently used)
#
# Note: Auto ads (Anchor, Interstitial) are managed by AdSense
# and do not require slot IDs. They activate automatically when
# enabled in your AdSense dashboard.
# ============================================

# ============================================
# ANALYTICS & TRACKING
# ============================================

# Google Analytics Measurement ID (optional)
# Format: G-XXXXXXXXXX
# Find this in: Google Analytics > Admin > Data Streams
# Public: Yes (required by browser to send analytics)
# Security: Not a secret - visible in every GA-enabled website's HTML
VITE_GA_MEASUREMENT_ID=

# ============================================
# IMPORTANT: ads.txt FILE CONFIGURATION
# ============================================
# Google AdSense REQUIRES an ads.txt file at your domain root:
# https://yourdomain.com/ads.txt
#
# Steps to configure ads.txt:
# 1. Open: public/ads.txt
# 2. Replace 'pub-0000000000000000' with YOUR Publisher ID
#    (same ID you use for VITE_ADSENSE_PUBLISHER_ID above)
# 3. Deploy the file with your website
# 4. Verify at: https://yourdomain.com/ads.txt
#
# The ads.txt file is REQUIRED by Google AdSense policy.
# Without it, ads may not display or your account may be suspended.
# ============================================
